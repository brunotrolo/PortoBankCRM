# =============================================================================
# Porto Bank CRM To-Be — Variáveis de Ambiente (Desenvolvimento Local)
# =============================================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com segredos reais.

# --- Ambiente ---
NODE_ENV=development
PORT=3000
APP_NAME=porto-bank-crm
API_PREFIX=api/v1

# --- Banco de Dados (PostgreSQL via Docker ou LocalStack) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/porto_bank_crm
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=porto_bank_crm

# --- Redis / ElastiCache (LocalStack ou Docker) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- AWS (para desenvolvimento local com LocalStack) ---
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566

# --- S3 (Auditoria Object Lock) ---
S3_AUDIT_BUCKET=porto-bank-crm-audit-local

# --- Cognito (Auth) ---
COGNITO_USER_POOL_ID=sa-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_DOMAIN=https://porto-bank-crm.auth.sa-east-1.amazoncognito.com

# --- Verified Permissions (Cedar) ---
VERIFIED_PERMISSIONS_POLICY_STORE_ID=PSExxxxxxxx

# --- KMS ---
KMS_KEY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Secrets Manager (Pepper blind index) ---
BLIND_INDEX_PEPPER_SECRET_ID=porto-bank-crm/blind-index-pepper

# --- IA (Provedor: Anthropic/OpenAI/OpenRouter) ---
AI_PROVIDER=anthropic
AI_MODEL=claude-3-sonnet
AI_API_KEY=sua_chave_aqui
AI_BUDGET_CENTS_MONTHLY=5000

# --- WAHA (WhatsApp) ---
WAHA_API_BASE_URL=http://localhost:3030
WAHA_API_KEY=sua_chave_waha
WAHA_WEBHOOK_HMAC_KEY=sua_chave_hmac

# --- Segurança ---
SESSION_SECRET=sua_chave_secreta_de_sessao
ENCRYPTION_KEY=sua_chave_de_criptografia_32_bytes

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Observabilidade ---
SENTRY_DSN=
XRAY_DAEMON_ADDRESS=127.0.0.1:2000

# --- Feature Flags ---
ENABLE_AI_AGENTS=true
ENABLE_LGPD=true
ENABLE_AUTOMATION_RULES=true
ENABLE_WHATSAPP=true
