# Porto Bank CRM — Terraform Variáveis de Exemplo
# Copie este arquivo para terraform.tfvars e preencha os valores reais.

environment     = "prod"
region          = "sa-east-1"
vpc_cidr        = "10.0.0.0/16"
az_count        = 3

# Substitua pelo ARN do seu certificado ACM para HTTPS
acm_certificate_arn = "arn:aws:acm:sa-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

db_master_password = "SUA_SENHA_FORTE_AQUI"

# Imagens dos containers (publicadas no ECR após build)
api_container_image    = "123456789012.dkr.ecr.sa-east-1.amazonaws.com/porto-bank-crm-api:latest"
worker_container_image = "123456789012.dkr.ecr.sa-east-1.amazonaws.com/porto-bank-crm-worker:latest"

desired_count = 2
max_count     = 10
min_count     = 1
